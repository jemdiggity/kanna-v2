{
  "name": "@kanna/firebase-functions",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js",
    "./billing-contract": "./src/billing/contract.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm exec vitest run --maxWorkers=2 --exclude 'dist/**'",
    "seed:billing": "pnpm build && node scripts/seed-billing-fixtures.mjs",
    "comp:grant": "pnpm build && node scripts/grant-comp-access.mjs",
    "stripe:provision": "node scripts/provision-stripe-catalog.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.3.2",
    "stripe": "^22.5.0"
  }
}
