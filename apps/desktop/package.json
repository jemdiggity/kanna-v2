{
  "name": "@kanna/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:sidecars": "pnpm -C ../.. run build:desktop-sidecars",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "KANNA_REQUIRE_SIDECARS=1 tauri",
    "tauri:dev": "KANNA_REQUIRE_SIDECARS=1 tauri dev",
    "tauri:build": "KANNA_REQUIRE_SIDECARS=1 tauri build",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; exec vitest run --maxWorkers=2 src tests/e2e \"$@\"' --",
    "test:e2e": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ \"$#\" -gt 0 ]; then exec tsx tests/e2e/run.ts \"$@\"; fi; exec tsx tests/e2e/run.ts mock/' --",
    "test:e2e:app-update": "tsx tests/e2e/run.ts mock/app-update.test.ts",
    "test:e2e:app-update:bundle": "pnpm -C ../.. exec kd test app-update-bundle",
    "test:e2e:real": "tsx tests/e2e/run.ts real/",
    "test:e2e:cloud-mobile-index": "tsx tests/e2e/run.ts real/cloud-task-mobile-index.test.ts",
    "test:e2e:all": "tsx tests/e2e/run.ts"
  },
  "dependencies": {
    "@kanna/agent-protocol": "workspace:*",
    "@kanna/stream-client": "workspace:*",
    "@kanna/visual-companion": "workspace:*",
    "@pierre/diffs": "^1.1.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "0.12.0-beta.195",
    "@xterm/addon-image": "0.10.0-beta.195",
    "@xterm/addon-serialize": "0.15.0-beta.195",
    "@xterm/addon-web-links": "0.13.0-beta.195",
    "@xterm/addon-webgl": "0.20.0-beta.194",
    "@xterm/xterm": "6.1.0-beta.195",
    "chart.js": "^4",
    "firebase": "^12.12.1",
    "markdown-it": "^14.1.0",
    "markdown-it-strikethrough-alt": "^1.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "pinia": "^3.0.4",
    "qrcode": "1.5.4",
    "shiki": "^4.0.2",
    "vue": "^3.5.13",
    "vue-chartjs": "^5",
    "vue-i18n": "^11.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.8.9",
    "playwright": "^1.61.0",
    "tsx": "^4.21.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.1.10"
  }
}
