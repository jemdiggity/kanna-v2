{
  "name": "@kanna/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "gen:terminal-assets": "node ./scripts/generate-terminal-assets.mjs",
    "test:e2e": "pnpm exec tsx ./e2e/run.ts",
    "test:e2e:smoke": "pnpm exec tsx ./e2e/run.ts smoke",
    "test:e2e:cloud": "pnpm exec tsx ./e2e/run.ts cloud",
    "test:e2e:relay": "pnpm exec tsx ./e2e/run.ts relay",
    "test:e2e:profile-disconnected": "pnpm exec tsx ./e2e/run.ts profile-disconnected",
    "test:e2e:preflight": "pnpm exec tsx ./e2e/preflight.ts",
    "test:e2e:device:preflight": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/preflight.ts",
    "test:e2e:device:smoke": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/run.ts smoke",
    "test:e2e:device:profile-disconnected": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/run.ts profile-disconnected",
    "test:e2e:appium:install-xcuitest": "pnpm exec tsx ./e2e/helpers/appium.ts install-xcuitest",
    "test:e2e:appium:start": "pnpm exec tsx ./e2e/helpers/appium.ts start",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ \"$1\" = \"--runInBand\" ]; then shift; fi; exec pnpm dlx vitest run \"$@\"' --",
    "typecheck": "pnpm exec tsc --noEmit",
    "android": "expo run:android"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@expo/vector-icons": "14.1.0",
    "@kanna/agent-protocol": "workspace:*",
    "@kanna/stream-client": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.0.0",
    "@xterm/addon-fit": "0.12.0-beta.195",
    "@xterm/xterm": "6.1.0-beta.195",
    "expo": "~53.0.0",
    "expo-constants": "17.1.8",
    "expo-dev-client": "~5.2.4",
    "expo-modules-core": "2.5.0",
    "expo-updates": "~0.28.18",
    "firebase": "^12.12.1",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@expo/config-plugins": "~10.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.14",
    "appium": "^2.19.0",
    "babel-preset-expo": "13.0.0",
    "tsx": "^4.21.0",
    "webdriverio": "^9.20.0"
  }
}
