{
  "name": "@kanna/mobile",
  "private": true,
  "version": "0.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "ios": "expo run:ios",
    "gen:terminal-assets": "node ./scripts/generate-terminal-assets.mjs",
    "test:e2e": "pnpm exec tsx ./e2e/run.ts",
    "test:e2e:smoke": "pnpm exec tsx ./e2e/run.ts smoke",
    "test:e2e:search-focus": "pnpm exec tsx ./e2e/run.ts search-focus",
    "test:e2e:tab-reselection": "pnpm exec tsx ./e2e/run.ts tab-reselection",
    "test:e2e:shell-visual": "pnpm exec tsx ./e2e/run.ts shell-visual",
    "test:e2e:cloud": "pnpm exec tsx ./e2e/run.ts cloud",
    "test:e2e:relay": "pnpm exec tsx ./e2e/run.ts relay",
    "test:e2e:hybrid": "pnpm exec tsx ./e2e/run.ts hybrid",
    "test:e2e:profile-disconnected": "pnpm exec tsx ./e2e/run.ts profile-disconnected",
    "test:e2e:preflight": "pnpm exec tsx ./e2e/preflight.ts",
    "test:e2e:device:preflight": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/preflight.ts",
    "test:e2e:device:smoke": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/run.ts smoke",
    "test:e2e:device:profile-disconnected": "KANNA_IOS_E2E_TARGET=device pnpm exec tsx ./e2e/run.ts profile-disconnected",
    "test:e2e:device:release-install": "KANNA_APP_ENV=staging pnpm exec tsx ./e2e/release-install-check.ts",
    "test:integration:agent-provider-inventory": "KANNA_RUN_AGENT_PROVIDER_INVENTORY_INTEGRATION=1 pnpm exec vitest run e2e/agentProviderInventory.integration.test.tsx --maxWorkers=1",
    "test:integration:expo-modules-jsi-worktrees": "KANNA_RUN_EXPO_MODULES_JSI_WORKTREE_CACHE_INTEGRATION=1 pnpm exec vitest run e2e/expoModulesJsiWorktreeCache.integration.test.ts --maxWorkers=1",
    "test:integration:firebase-account": "KANNA_RUN_MOBILE_FIREBASE_ACCOUNT_INTEGRATION=1 pnpm exec vitest run src/lib/firebase/accountJourney.emulator.integration.test.ts --maxWorkers=1",
    "test:e2e:appium:install-xcuitest": "pnpm exec tsx ./e2e/helpers/appium.ts install-xcuitest",
    "test:e2e:appium:start": "pnpm exec tsx ./e2e/helpers/appium.ts start",
    "test": "sh -c 'if [ \"$1\" = \"--\" ]; then shift; fi; if [ \"$1\" = \"--runInBand\" ]; then shift; fi; exec pnpm exec vitest run --maxWorkers=2 \"$@\"' --",
    "typecheck": "pnpm exec tsc --noEmit",
    "android": "expo run:android"
  },
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@expo/dom-webview": "~57.0.1",
    "@expo/vector-icons": "15.1.1",
    "@kanna/agent-protocol": "workspace:*",
    "@kanna/stream-client": "workspace:*",
    "@kanna/visual-companion": "workspace:*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-firebase/app": "^26.0.0",
    "@react-native-firebase/messaging": "^26.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native": "^7.3.10",
    "@react-navigation/native-stack": "^7.18.1",
    "@xterm/addon-fit": "0.12.0-beta.195",
    "@xterm/xterm": "6.1.0-beta.195",
    "expo": "~57.0.15",
    "expo-application": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-dev-client": "~57.0.14",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-manipulator": "~57.0.12",
    "expo-image-picker": "~57.0.12",
    "expo-notifications": "~57.0.13",
    "expo-updates": "~57.0.16",
    "firebase": "^12.12.1",
    "highlight.js": "11.11.1",
    "markdown-it": "14.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@expo/config-plugins": "~57.0.6",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-test-renderer": "19.1.0",
    "appium": "^2.19.0",
    "babel-preset-expo": "57.0.2",
    "pngjs": "7.0.0",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.21.0",
    "vitest": "^4.1.4",
    "webdriverio": "^9.20.0"
  }
}
