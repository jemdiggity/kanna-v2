+    zig_runtime_files = ""
+    if repository_ctx.attr.platform == "aarch64-macos" and repository_ctx.attr.zig_version == "0.15.2":
+        # Xcode 26.5's top-level libSystem TBD targets omit arm64-macos, while
+        # the CLT 26.2 SDK retains it. Official Zig 0.15.2 fails with the Xcode
+        # SDK and links with the CLT SDK. Keep the compiler fetched and checked
+        # by rules_zig, and scope the compatible SDK selection to Zig only.
+        zig_exe = "zig-macos-sdk-wrapper"
+        zig_runtime_files = " + [\"zig\"]"
+        repository_ctx.file(
+            zig_exe,
+            content = """#!/bin/sh
+set -eu
+clt_dir=/Library/Developer/CommandLineTools
+if [ ! -d "$clt_dir/SDKs/MacOSX.sdk" ]; then
+  echo "Kanna's hermetic Zig 0.15.2 toolchain requires the Apple Command Line Tools SDK at $clt_dir/SDKs/MacOSX.sdk" >&2
+  exit 1
+fi
+
+# rules_rust does not interpolate OUT_DIR inside annotation environment
+# values. Resolve those paths here while the runner's real OUT_DIR is present,
+# so Ghostty's Zig caches work in Bazel's normal sandbox.
+case "${HOME:-}" in
+  '${OUT_DIR}'/*) HOME="$OUT_DIR/${HOME#'${OUT_DIR}'/}"; export HOME ;;
+esac
+case "${XDG_CACHE_HOME:-}" in
+  '${OUT_DIR}'/*) XDG_CACHE_HOME="$OUT_DIR/${XDG_CACHE_HOME#'${OUT_DIR}'/}"; export XDG_CACHE_HOME ;;
+esac
+case "${ZIG_GLOBAL_CACHE_DIR:-}" in
+  '${OUT_DIR}'/*) ZIG_GLOBAL_CACHE_DIR="$OUT_DIR/${ZIG_GLOBAL_CACHE_DIR#'${OUT_DIR}'/}"; export ZIG_GLOBAL_CACHE_DIR ;;
+esac
+case "${ZIG_LOCAL_CACHE_DIR:-}" in
+  '${OUT_DIR}'/*) ZIG_LOCAL_CACHE_DIR="$OUT_DIR/${ZIG_LOCAL_CACHE_DIR#'${OUT_DIR}'/}"; export ZIG_LOCAL_CACHE_DIR ;;
+esac
+for cache_dir in "${HOME:-}" "${XDG_CACHE_HOME:-}" "${ZIG_GLOBAL_CACHE_DIR:-}" "${ZIG_LOCAL_CACHE_DIR:-}"; do
+  [ -z "$cache_dir" ] || mkdir -p "$cache_dir"
+done
+DEVELOPER_DIR="$clt_dir" exec "$(dirname "$0")/zig" "$@"
+""",
+            executable = True,
+        )
+
