+        repository_ctx.file(
+            zig_exe,
+            content = """#!/bin/sh
+set -eu
+sdkroot=
+developer_dir=
+for sdk in /Library/Developer/CommandLineTools/SDKs/MacOSX*.sdk; do
+  if [ -f "$sdk/usr/lib/libSystem.tbd" ] && sed -n '1,/^install-name:/p' "$sdk/usr/lib/libSystem.tbd" | grep -q 'arm64-macos'; then
+    sdkroot=$(cd "$sdk" && pwd -P)
+    developer_dir=/Library/Developer/CommandLineTools
+    break
+  fi
+done
+if [ -z "$sdkroot" ]; then
+  for sdk in /Applications/Xcode*.app/Contents/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX*.sdk; do
+    if [ -f "$sdk/usr/lib/libSystem.tbd" ] && sed -n '1,/^install-name:/p' "$sdk/usr/lib/libSystem.tbd" | grep -q 'arm64-macos'; then
+      sdkroot=$(cd "$sdk" && pwd -P)
+      developer_dir=${sdk%%/Platforms/MacOSX.platform/Developer/SDKs/*}
+      break
+    fi
+  done
+fi
+if [ -z "$sdkroot" ]; then
+  echo "Kanna's hermetic Zig 0.15.2 toolchain requires a macOS SDK whose top-level libSystem.tbd targets include arm64-macos; none was found in the Command Line Tools or Xcode" >&2
+  exit 1
+fi
+echo "Kanna hermetic Zig 0.15.2 selected macOS SDK: $sdkroot" >&2
+export DEVELOPER_DIR="$developer_dir" SDKROOT="$sdkroot"
+export PATH="$(dirname "$0"):$PATH"
+
+# rules_rust does not interpolate OUT_DIR inside annotation environment
+# values. Resolve those paths here while the runner's real OUT_DIR is present,
+# so Ghostty's Zig caches work in Bazel's normal sandbox.
+case "${HOME:-}" in
+  '${OUT_DIR}'/*) HOME="$OUT_DIR/${HOME#'${OUT_DIR}'/}"; export HOME ;;
+esac
+case "${XDG_CACHE_HOME:-}" in
+  '${OUT_DIR}'/*) XDG_CACHE_HOME="$OUT_DIR/${XDG_CACHE_HOME#'${OUT_DIR}'/}"; export XDG_CACHE_HOME ;;
+esac
+case "${ZIG_GLOBAL_CACHE_DIR:-}" in
+  '${OUT_DIR}'/*) ZIG_GLOBAL_CACHE_DIR="$OUT_DIR/${ZIG_GLOBAL_CACHE_DIR#'${OUT_DIR}'/}"; export ZIG_GLOBAL_CACHE_DIR ;;
+esac
+case "${ZIG_LOCAL_CACHE_DIR:-}" in
+  '${OUT_DIR}'/*) ZIG_LOCAL_CACHE_DIR="$OUT_DIR/${ZIG_LOCAL_CACHE_DIR#'${OUT_DIR}'/}"; export ZIG_LOCAL_CACHE_DIR ;;
+esac
+for cache_dir in "${HOME:-}" "${XDG_CACHE_HOME:-}" "${ZIG_GLOBAL_CACHE_DIR:-}" "${ZIG_LOCAL_CACHE_DIR:-}"; do
+  [ -z "$cache_dir" ] || mkdir -p "$cache_dir"
+done
+exec "$(dirname "$0")/zig" "$@" --sysroot "$sdkroot"
+""",
+            executable = True,
+        )
