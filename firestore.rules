rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function accountDeletionHasNotStarted(uid) {
      return !exists(/databases/$(database)/documents/accountDeletions/$(uid));
    }

    function expectedProfileFields() {
      return [
        'displayName',
        'photoURL',
        'locale',
        'primaryEmail',
        'updatedAt',
      ];
    }

    function privilegedUserFields() {
      return [
        'admin',
        'desktopSecret',
        'desktopSecretHash',
        'isAdmin',
        'role',
        'roles',
        'secret',
      ];
    }

    function changedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isExpectedProfileUpdate() {
      return changedUserFields().hasOnly(expectedProfileFields())
        && !changedUserFields().hasAny(privilegedUserFields())
        && isExpectedPrimaryEmail();
    }

    function isExpectedProfileCreate() {
      return request.resource.data.keys().hasOnly(expectedProfileFields())
        && isExpectedPrimaryEmail();
    }

    function isExpectedPrimaryEmail() {
      return !request.resource.data.keys().hasAny(['primaryEmail'])
        || (
          request.auth.token.email is string
          && request.resource.data.primaryEmail == request.auth.token.email
        );
    }

    match /users/{uid} {
      allow get: if isSignedInAs(uid);
      allow list, delete: if false;
      allow create: if isSignedInAs(uid)
        && accountDeletionHasNotStarted(uid)
        && isExpectedProfileCreate();
      allow update: if isSignedInAs(uid)
        && accountDeletionHasNotStarted(uid)
        && isExpectedProfileUpdate();

      match /tasks/{taskId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }

      match /desktops/{desktopDocId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;

        match /tasks/{taskDocId} {
          allow read: if isSignedInAs(uid);
          allow write: if false;
        }
      }

      match /transfers/{transferId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }

      // Derived entitlement record. Owner-readable so the portal, desktop and
      // mobile can render active/grace/inactive; written only by the
      // recomputeEntitlement reducer through the admin SDK, never by a client.
      match /entitlements/{entitlementId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }

      // Per-source billing state (stripe | app_store | comp). Owner-readable,
      // admin-written. `comp` lives here too: a client that could write its own
      // comp grant would grant itself cloud access.
      match /billing/{sourceId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }
    }

    match /desktopPresence/{desktopId} {
      allow read, write: if false;
    }

    // Reverse map from Apple's appAccountToken to a uid (written in Slice 2).
    // Neither readable nor writable by clients: the token is the binding
    // between an App Store transaction and an account, and a client that could
    // read or forge one could bind a purchase to somebody else's account.
    match /appAccountTokens/{appAccountToken} {
      allow read, write: if false;
    }

    // Stripe webhook dedupe ledger and the Stripe customer reverse map. Server
    // bookkeeping; no client has any business reading or writing either.
    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }

    match /stripeCustomers/{customerId} {
      allow read, write: if false;
    }

    match /desktopCredentials/{desktopId} {
      function canonicalCredentialFields() {
        return [
          'desktopId',
          'desktopSecretHash',
          'displayName',
          'revokedAt',
          'uid',
          'updatedAt',
        ];
      }

      function hasCanonicalCredentialFields() {
        return request.resource.data.keys().hasOnly(canonicalCredentialFields())
          && request.resource.data.keys().hasAll(canonicalCredentialFields());
      }

      allow read: if false;
      allow delete: if false;
      allow create: if request.auth != null
        && accountDeletionHasNotStarted(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.desktopId == desktopId
        && hasCanonicalCredentialFields();
      allow update: if request.auth != null
        && accountDeletionHasNotStarted(request.auth.uid)
        && request.resource.data.uid == request.auth.uid
        && resource.data.desktopId == desktopId
        && request.resource.data.desktopId == desktopId
        && request.resource.data.desktopSecretHash == resource.data.desktopSecretHash
        && hasCanonicalCredentialFields()
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.revokedAt != null
            && request.resource.data.revokedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName',
              'revokedAt',
              'uid',
              'updatedAt',
            ])
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
