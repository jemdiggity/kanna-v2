rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function expectedProfileFields() {
      return [
        'displayName',
        'photoURL',
        'locale',
        'primaryEmail',
        'updatedAt',
      ];
    }

    function privilegedUserFields() {
      return [
        'admin',
        'desktopSecret',
        'desktopSecretHash',
        'isAdmin',
        'role',
        'roles',
        'secret',
      ];
    }

    function changedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isExpectedProfileUpdate() {
      return changedUserFields().hasOnly(expectedProfileFields())
        && !changedUserFields().hasAny(privilegedUserFields())
        && isExpectedPrimaryEmail();
    }

    function isExpectedProfileCreate() {
      return request.resource.data.keys().hasOnly(expectedProfileFields())
        && isExpectedPrimaryEmail();
    }

    function isExpectedPrimaryEmail() {
      return !request.resource.data.keys().hasAny(['primaryEmail'])
        || (
          request.auth.token.email is string
          && request.resource.data.primaryEmail == request.auth.token.email
        );
    }

    match /users/{uid} {
      allow get: if isSignedInAs(uid);
      allow list, delete: if false;
      allow create: if isSignedInAs(uid) && isExpectedProfileCreate();
      allow update: if isSignedInAs(uid) && isExpectedProfileUpdate();

      match /tasks/{taskId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }

      match /desktops/{desktopDocId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;

        match /tasks/{taskDocId} {
          allow read: if isSignedInAs(uid);
          allow write: if false;
        }
      }

      match /transfers/{transferId} {
        allow read: if isSignedInAs(uid);
        allow write: if false;
      }
    }

    match /desktopPresence/{desktopId} {
      allow read, write: if false;
    }

    match /desktopCredentials/{desktopId} {
      allow read: if false;
      allow delete: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.desktopId == desktopId
        && request.resource.data.keys().hasOnly([
          'desktopId',
          'desktopSecretHash',
          'displayName',
          'revokedAt',
          'uid',
          'updatedAt',
        ]);
      allow update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && resource.data.desktopId == desktopId
        && request.resource.data.desktopId == desktopId
        && request.resource.data.desktopSecretHash == resource.data.desktopSecretHash
        && request.resource.data.keys().hasOnly([
          'desktopId',
          'desktopSecretHash',
          'displayName',
          'revokedAt',
          'uid',
          'updatedAt',
        ])
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.revokedAt != null
            && request.resource.data.revokedAt == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'displayName',
              'revokedAt',
              'uid',
              'updatedAt',
            ])
          )
        );
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
