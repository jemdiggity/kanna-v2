load("@kanna_cli_crates//:defs.bzl", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_srcs",
    srcs = [
        "Cargo.lock",
        "Cargo.toml",
    ] + glob(["src/**/*.rs"]),
)

rust_binary(
    name = "kanna_cli",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "kanna_cli",
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//crates/runtime-defaults:kanna_runtime_defaults",
        "//crates/kanna-tool-catalog:kanna_tool_catalog_for_cli",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
)

rust_binary(
    name = "kanna_cli_x86_64",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/main.rs",
    crate_name = "kanna_cli",
    edition = "2021",
    deps = all_crate_deps(normal = True) + [
        "//crates/runtime-defaults:kanna_runtime_defaults",
        "//crates/kanna-tool-catalog:kanna_tool_catalog_for_cli",
    ],
    proc_macro_deps = all_crate_deps(proc_macro = True),
    platform = "//tools/bazel:macos_x86_64",
)
