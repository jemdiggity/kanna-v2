load("@kanna_server_crates//:defs.bzl", all_crate_deps_for_server = "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")
load("@task_transfer_crates//:defs.bzl", all_crate_deps_for_task_transfer = "all_crate_deps")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_srcs",
    srcs = [
        "Cargo.toml",
    ] + glob(["src/**/*.rs"]),
)

rust_library(
    name = "kanna_visual_companion_for_server",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "kanna_visual_companion",
    edition = "2021",
    deps = all_crate_deps_for_server(
        normal = True,
        package_name = "crates/visual-companion",
    ) + [
        "//crates/kanna-agent-protocol:kanna_agent_protocol_for_server",
    ],
    proc_macro_deps = all_crate_deps_for_server(
        proc_macro = True,
        package_name = "crates/visual-companion",
    ),
)

rust_library(
    name = "kanna_visual_companion_for_task_transfer",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "kanna_visual_companion",
    edition = "2021",
    deps = all_crate_deps_for_task_transfer(
        normal = True,
        package_name = "crates/visual-companion",
    ) + [
        "//crates/kanna-agent-protocol:kanna_agent_protocol_for_task_transfer",
    ],
    proc_macro_deps = all_crate_deps_for_task_transfer(
        proc_macro = True,
        package_name = "crates/visual-companion",
    ),
)
