load("@daemon_crates//:defs.bzl", all_crate_deps_for_daemon = "all_crate_deps")
load("@kanna_server_crates//:defs.bzl", all_crate_deps_for_server = "all_crate_deps")
load("@task_transfer_crates//:defs.bzl", all_crate_deps_for_task_transfer = "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "cargo_srcs",
    srcs = [
        "Cargo.toml",
    ] + glob(["src/**/*.rs"]),
)

rust_library(
    name = "kanna_agent_protocol_for_daemon",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "kanna_agent_protocol",
    edition = "2021",
    deps = all_crate_deps_for_daemon(
        normal = True,
        package_name = "crates/kanna-agent-protocol",
    ) + [
        "//crates/claude-agent-sdk:claude_agent_sdk_for_daemon",
    ],
    proc_macro_deps = all_crate_deps_for_daemon(
        proc_macro = True,
        package_name = "crates/kanna-agent-protocol",
    ),
)

rust_library(
    name = "kanna_agent_protocol_for_server",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "kanna_agent_protocol",
    edition = "2021",
    deps = all_crate_deps_for_server(
        normal = True,
        package_name = "crates/kanna-agent-protocol",
    ) + [
        "//crates/claude-agent-sdk:claude_agent_sdk_for_server",
    ],
    proc_macro_deps = all_crate_deps_for_server(
        proc_macro = True,
        package_name = "crates/kanna-agent-protocol",
    ),
)

rust_library(
    name = "kanna_agent_protocol_for_task_transfer",
    srcs = glob(["src/**/*.rs"]),
    crate_root = "src/lib.rs",
    crate_name = "kanna_agent_protocol",
    edition = "2021",
    deps = all_crate_deps_for_task_transfer(
        normal = True,
        package_name = "crates/kanna-agent-protocol",
    ) + [
        "//crates/claude-agent-sdk:claude_agent_sdk_for_task_transfer",
    ],
    proc_macro_deps = all_crate_deps_for_task_transfer(
        proc_macro = True,
        package_name = "crates/kanna-agent-protocol",
    ),
)
