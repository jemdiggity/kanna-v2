{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kanna.build/config.schema.json",
  "title": "Kanna Repo Config",
  "description": "Schema for .kanna/config.json used by Kanna agents and editors.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "pipeline": {
      "type": "string"
    },
    "setup": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teardown": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ports": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "flavors": {
      "type": "object",
      "description": "Per-role built-in agent flavor selections. A stage with agent \"pr\" uses flavors.pr when present; an explicit selector such as \"pr@draft-pr\" takes precedence.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "vars": {
      "type": "object",
      "description": "String variables substituted in AGENT.md bodies with $NAME or ${NAME}. Runtime prompt variables such as $BASE_REF, $BRANCH, $PREV_RESULT, $SOURCE_WORKTREE, and $TASK_PROMPT remain runtime-bound and are not replaced by config vars.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "reserved_port_offsets": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "reserved_ports": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "stage_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "path": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "prepend": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "append": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "setup": [
        "pnpm install"
      ],
      "ports": {
        "KANNA_DEV_PORT": 1420
      }
    },
    {
      "workspace": {
        "path": {
          "prepend": [
            "./node_modules/.bin"
          ]
        }
      }
    },
    {
      "workspace": {
        "env": {
          "FOO": "bar"
        }
      }
    },
    {
      "flavors": {
        "pr": "draft-pr",
        "merge": "github"
      },
      "vars": {
        "MERGE_STRATEGY": "merge",
        "REVIEW_TEAM": "platform"
      }
    }
  ]
}
