{
  "$schema": "https://schemas.kanna.build/config.schema.json",
  "setup": [
    "pnpm install",
    "./kd env sync",
    "./kd rust-cache install"
  ],
  "teardown": ["./kd dev down --kill-daemon", "./kd clean --all"],
  "test": ["pnpm test"],
  "agentProviders": {
    "review": {
      "provider": ["codex", "claude", "copilot", "opencode", "antigravity"]
    },
    "review-*": {
      "provider": ["codex", "claude", "copilot", "opencode", "antigravity"]
    },
    "qa-dispatcher": {
      "provider": ["codex", "claude", "copilot", "opencode", "antigravity"]
    }
  },
  "workspace": {
    "path": {
      "prepend": ["./node_modules/.bin"]
    }
  },
  "ports": {
    "KANNA_DEV_PORT": 1420,
    "KANNA_WEBDRIVER_PORT": 4445,
    "KANNA_RELAY_PORT": 9080,
    "KANNA_MOBILE_SERVER_PORT": 48120,
    "KANNA_MOBILE_PORT": 8081,
    "KANNA_APPIUM_PORT": 4723,
    "KANNA_TRANSFER_PORT": 4455,
    "KANNA_FIREBASE_AUTH_PORT": 9099,
    "KANNA_FIREBASE_FIRESTORE_PORT": 8080,
    "KANNA_FIREBASE_FUNCTIONS_PORT": 5001,
    "KANNA_FIREBASE_UI_PORT": 4000
  },
  "reserved_port_offsets": [0, 1]
}
