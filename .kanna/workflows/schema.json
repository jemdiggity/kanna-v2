{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kanna.build/workflow.schema.json",
  "title": "Kanna Workflow Definition",
  "description": "Schema for .kanna/workflows/*.json workflow definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "stages"],
  "$defs": {
    "agentProvider": {
      "enum": ["claude", "copilot", "codex", "opencode", "antigravity"]
    },
    "agentProviderSelection": {
      "oneOf": [
        {
          "$ref": "#/$defs/agentProvider"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agentProvider"
          },
          "minItems": 1
        }
      ]
    }
  },
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "visibility": {
      "description": "Whether this workflow is offered as a choice. \"internal\" keeps the name out of every listing (the repo manifest, the desktop's new-task picker, the tool catalog's advertised lineup) while it still resolves when named explicitly on task creation — visibility governs listing, not access. Defaults to \"public\" when absent.",
      "enum": ["public", "internal"]
    },
    "revision_limit": {
      "description": "Agent-requested revision rounds a task may spend before Kanna stops forking revisions and parks the task for its human. Defaults to 5 when omitted; 0 disables the cap. A human-requested revision is never refused and resets the count.",
      "type": "integer",
      "minimum": 0
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "setup": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "teardown": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "policy"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "agent_provider": {
            "$ref": "#/$defs/agentProviderSelection"
          },
          "environment": {
            "type": "string"
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transition"],
            "properties": {
              "transition": {
                "enum": ["manual", "auto"]
              },
              "revision_transition": {
                "description": "Completion policy for main runs entered through a revision request. Defaults to transition when omitted.",
                "enum": ["manual", "auto"]
              }
            }
          },
          "post": {
            "type": "object",
            "description": "Tail work injected into the stage's running agent session when the stage transitions forward. `agent` is the fallback spawned when the session is dead.",
            "additionalProperties": false,
            "required": ["name", "prompt"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "agent": {
                "type": "string"
              },
              "prompt": {
                "type": "string"
              },
              "agent_provider": {
                "$ref": "#/$defs/agentProviderSelection"
              }
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "$schema": "./schema.json",
      "name": "default",
      "description": "Standard in progress (commit as post) -> PR flow",
      "stages": [
        {
          "name": "in progress",
          "agent": "implement",
          "prompt": "$TASK_PROMPT",
          "policy": { "transition": "manual", "revision_transition": "auto" },
          "post": {
            "name": "commit",
            "agent": "commit",
            "prompt": "Commit the relevant work for this task. Original task: $TASK_PROMPT"
          }
        },
        {
          "name": "pr",
          "agent": "pr",
          "prompt": "Create a PR for the work on branch $BRANCH. Previous result: $PREV_RESULT",
          "policy": { "transition": "manual" }
        }
      ]
    },
    {
      "$schema": "./schema.json",
      "name": "orchestrated-child",
      "description": "A workflow an orchestrating agent binds for the child tasks it creates; internal keeps it out of the new-task picker while it still resolves by name",
      "visibility": "internal",
      "stages": [
        {
          "name": "review",
          "prompt": "$TASK_PROMPT",
          "policy": { "transition": "manual" }
        }
      ]
    }
  ]
}
