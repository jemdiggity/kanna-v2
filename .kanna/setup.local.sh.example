#!/bin/sh

# Copy this file to .kanna/setup.local.sh in the repository's primary checkout,
# make it executable, and replace these two machine-local values. Kanna invokes
# that one shared hook from every worktree, with the worktree as $PWD.
external_volume="/path/to/external-volume"
external_build_root="$external_volume/kanna-builds/kanna"

warn() {
  printf 'Kanna local setup: %s\n' "$*" >&2
}

workspace_root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
workspace_name=$(basename "$workspace_root")
local_build="$workspace_root/.build"
external_workspace_build="$external_build_root/$workspace_name"

# This exact symlink is the source of truth shared with `kd env sync` and
# `kd clean`: Cargo follows it for builds, and cleanup reads and validates it
# instead of independently reconstructing this machine-local path.

# A previously configured link becomes dangling if the volume is ejected.
# Replace only this hook's dangling link with an empty local directory; the
# external artifacts remain untouched and can be relinked after remounting.
if [ ! -d "$external_volume" ] || [ ! -w "$external_volume" ]; then
  if [ -L "$local_build" ] && [ ! -e "$local_build" ]; then
    link_target=$(readlink "$local_build" 2>/dev/null || true)
    case "$link_target" in
      "$external_build_root"/*)
        if rm "$local_build" && mkdir "$local_build"; then
          warn "external build volume unavailable; replaced dangling .build link with a local directory"
        else
          warn "external build volume unavailable and dangling .build link could not be repaired"
        fi
        ;;
    esac
  fi
  exit 0
fi

if ! mkdir -p "$external_build_root"; then
  warn "could not create $external_build_root; keeping the current .build layout"
  exit 0
fi

if [ -L "$local_build" ]; then
  link_target=$(readlink "$local_build" 2>/dev/null || true)
  if [ "$link_target" = "$external_workspace_build" ]; then
    if ! mkdir -p "$external_workspace_build"; then
      warn "could not create $external_workspace_build"
    fi
  else
    warn ".build is already a symlink to another location; leaving it unchanged"
  fi
  exit 0
fi

if [ -d "$local_build" ]; then
  if [ ! -e "$external_workspace_build" ]; then
    if mv "$local_build" "$external_workspace_build"; then
      if ! ln -s "$external_workspace_build" "$local_build"; then
        warn "migrated artifacts to $external_workspace_build but could not create the .build link"
      fi
    else
      warn "could not migrate the existing .build directory; leaving it unchanged"
    fi
    exit 0
  fi

  # An empty local fallback created while the volume was absent is safe to
  # replace. Never merge or delete a non-empty local build tree implicitly.
  if [ -z "$(ls -A "$local_build" 2>/dev/null)" ]; then
    if rmdir "$local_build" && ln -s "$external_workspace_build" "$local_build"; then
      exit 0
    fi
    mkdir -p "$local_build" 2>/dev/null || true
    warn "could not restore the .build link; keeping a local directory"
  else
    warn "both local and external build directories exist; leaving the local artifacts unchanged"
  fi
  exit 0
fi

if [ -e "$local_build" ]; then
  warn ".build exists but is not a directory or symlink; leaving it unchanged"
  exit 0
fi

if ! mkdir -p "$external_workspace_build"; then
  warn "could not create $external_workspace_build"
  exit 0
fi

if ! ln -s "$external_workspace_build" "$local_build"; then
  warn "could not link .build to $external_workspace_build"
fi

exit 0
