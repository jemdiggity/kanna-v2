package(default_visibility = ["//visibility:public"])

load("@aspect_rules_js//npm:defs.bzl", "npm_package")
load("@bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@kanna_npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(
    name = "node_modules",
)

filegroup(
    name = "srcs",
    srcs = [
        "package.json",
        "tsconfig.json",
    ] + glob([
        "src/**",
    ]),
)

npm_package(
    name = "pkg",
    srcs = [":srcs"],
    package = "@kanna/agent-protocol",
)

copy_to_bin(
    name = "srcs_in_bin",
    srcs = [":srcs"],
)
